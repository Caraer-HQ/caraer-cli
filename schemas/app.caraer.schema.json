{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/caraer/caraer-cli/main/schemas/app.caraer.schema.json",
  "title": "Caraer app manifest (app.caraer.yaml)",
  "type": "object",
  "required": ["name", "label", "authMethod", "brandmark", "details"],
  "additionalProperties": true,
  "properties": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "description": "Remote app UUID (filled after push)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Stable machine name."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable display name."
    },
    "description": { "type": "string" },
    "runtime": {
      "type": "string",
      "enum": ["nodejs22", "python312"],
      "description": "App-level runtime for platformVersion 2026.2."
    },
    "authMethod": {
      "type": "string",
      "enum": ["OAUTH2", "API_KEY"]
    },
    "hideApiKeyField": {
      "type": "boolean",
      "default": true,
      "description": "When true, hide the installation API key field in the Caraer UI. Defaults to true for new scaffolds."
    },
    "oauthRedirectUris": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "description": "Required when authMethod is OAUTH2."
    },
    "brandmark": {
      "type": "string",
      "format": "uri",
      "description": "Square brandmark SVG URL used in compact app surfaces. Required for public apps."
    },
    "requiredScopes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "settingsSchema": {
      "type": "array",
      "items": { "$ref": "#/$defs/settingField" }
    },
    "settingsSections": {
      "type": "array",
      "description": "Optional UI grouping of settingsSchema fields into installer cards. Settings values stay on the flat settingsSchema list.",
      "items": { "$ref": "#/$defs/settingsSection" }
    },
    "pricingPlans": {
      "type": "array",
      "items": { "$ref": "#/$defs/pricingPlan" }
    },
    "appBars": {
      "type": "array",
      "items": { "$ref": "#/$defs/appBar" }
    },
    "externalOAuthProviders": {
      "type": "array",
      "items": { "$ref": "#/$defs/oauthProvider" }
    },
    "webhookRateLimitPerMinute": { "type": "integer", "minimum": 0 },
    "billFailedWebhookRequests": { "type": "boolean" },
    "details": {
      "type": "object",
      "required": ["category", "brandColor", "image"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": {
          "type": "string",
          "description": "Marketplace main category (e.g. developer_tools)."
        },
        "subcategories": {
          "type": "array",
          "items": { "type": "string" }
        },
        "url": { "type": "string", "format": "uri" },
        "image": {
          "type": "string",
          "format": "uri",
          "description": "App logo SVG URL for marketplace listing. Required for public apps."
        },
        "brandColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "textColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    }
  },
  "$defs": {
    "settingsSection": {
      "type": "object",
      "required": ["title", "settings"],
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Installer card heading."
        },
        "subtitle": {
          "type": "string",
          "description": "Optional card description under the title."
        },
        "settings": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Ordered settingsSchema field names shown on this card."
        }
      }
    },
    "settingField": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "SINGLE_LINE",
            "MULTI_LINE",
            "SINGLE_SELECT",
            "MULTI_SELECT",
            "RECORD_SINGLE_SELECT",
            "RECORD_MULTI_SELECT",
            "OBJECT_SINGLE_SELECT",
            "OBJECT_MULTI_SELECT",
            "PROPERTY_SINGLE_SELECT",
            "PROPERTY_MULTI_SELECT",
            "SWITCH",
            "MAPPING",
            "FILE",
            "SECRET"
          ]
        },
        "required": { "type": "boolean" },
        "helpText": { "type": "string" },
        "defaultValue": {},
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "label": { "type": "string" },
              "helpText": { "type": "string" }
            }
          }
        },
        "optionsSource": { "$ref": "#/$defs/optionsSource" },
        "hidden": {
          "type": "boolean",
          "description": "Never show this field. The value is still stored so the app can keep provisioned ids."
        },
        "visibleWhen": {
          "type": "array",
          "items": { "$ref": "#/$defs/settingCondition" },
          "description": "Show and validate this field only while every condition holds."
        },
        "valueScope": {
          "type": "string",
          "enum": ["COMPANY", "USER"],
          "description": "COMPANY (default) stores the value on the install; USER stores it per Caraer user."
        }
      }
    },
    "settingCondition": {
      "type": "object",
      "required": ["field"],
      "additionalProperties": true,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1,
          "description": "Name of another field in the same settingsSchema."
        },
        "operator": {
          "type": "string",
          "enum": ["EQUALS", "NOT_EQUALS", "IN", "NOT_IN", "IS_SET", "IS_NOT_SET"],
          "default": "EQUALS"
        },
        "value": {
          "description": "Expected value; a list for IN / NOT_IN, omitted for IS_SET / IS_NOT_SET."
        }
      }
    },
    "optionsSource": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "const": "SERVERLESS",
          "description": "Only SERVERLESS is supported today."
        },
        "serverlessFunctionName": {
          "type": "string",
          "description": "Local/deployed function name (preferred for manifests)."
        },
        "serverlessFunctionUuid": {
          "type": "string",
          "description": "Remote function UUID (optional if name is set)."
        },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Sibling setting names. Installer clears this field and refetches options when any dependency value changes."
        },
        "searchable": { "type": "boolean" },
        "minQueryLength": { "type": "integer", "minimum": 0 }
      }
    },
    "pricingPlan": {
      "type": "object",
      "required": ["pricingType"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "pricingType": { "type": "string", "enum": ["FLAT", "TIERED"] },
        "pricePerUnit": { "type": ["number", "string"] },
        "unit": { "type": "string" },
        "tiers": { "type": "array" }
      }
    },
    "appBar": {
      "type": "object",
      "required": ["location", "label"],
      "additionalProperties": true,
      "properties": {
        "location": {
          "type": "string",
          "enum": [
            "RECORD_PREVIEW",
            "RECORD_OVERVIEW",
            "RECORD_DETAIL",
            "TOOL_BAR",
            "TRAIT_BAR"
          ]
        },
        "uuid": {
          "type": "string",
          "format": "uuid",
          "description": "Stable AppBar node UUID. Optional when name is unique and already deployed."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Unique bar name. Used to reuse the existing AppBar node when uuid is omitted."
        },
        "label": { "type": "string", "minLength": 1 },
        "actionLabel": { "type": "string" },
        "iframeUrl": { "type": "string" },
        "webhook": { "type": "object" }
      }
    },
    "oauthProvider": {
      "type": "object",
      "required": ["name", "authorizeUrl", "tokenUrl"],
      "additionalProperties": true,
      "properties": {
        "uuid": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "authorizeUrl": { "type": "string" },
        "tokenUrl": { "type": "string" },
        "clientId": { "type": "string" },
        "logo": { "type": "string" },
        "connectionOwner": {
          "type": "string",
          "enum": ["COMPANY", "USER"],
          "description": "COMPANY (default) = one shared connection per install; USER = one connection per Caraer user."
        },
        "scopes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
